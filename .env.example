AUTH_GITHUB_ID=your-github-oauth-client-id
AUTH_GITHUB_SECRET=your-github-oauth-client-secret
AUTH_SECRET=generate-a-random-auth-secret
SOCKET_AUTH_SECRET=generate-a-different-random-secret-of-at-least-32-bytes
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
CLIENT_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://127.0.0.1:3001
MATCH_HISTORY_URL=http://127.0.0.1:3000/api/internal/match-history
# Backend-only settings: uncomment in server/.env, not web .env.local.
# HOST=127.0.0.1
# PORT=3001
# RECONNECT_GRACE_MS=30000
