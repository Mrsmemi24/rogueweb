generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model MatchHistory {
  id              String   @id @default(cuid())
  matchId         String?
  playerId        String   // Identificador estable validado de la cuenta
  playerName      String
  levelReached    Int
  enemiesDefeated Int
  durationSeconds Int      // tiempo de la partida
  inventory       Json     // JSON con el inventario
  result          String   // "victory" | "defeat" | "abandoned"
  createdAt       DateTime @default(now())

  @@index([playerId])
  @@index([createdAt])
  @@index([levelReached])
  @@unique([matchId, playerId])
}